# npm start only (not tests, not production builds): call the local backend directly, like production
# calls Railway. The backend's default CORS_ALLOWED_ORIGINS already allows http://localhost:3000.
#
# (CRA's "proxy" setting is not used: it rewrote Origin to the backend's address and added
# X-Forwarded-Host, so the backend - which trusts forwarded headers behind Railway - rejected every
# POST as an invalid CORS request.)
REACT_APP_API_URL=http://localhost:8080
